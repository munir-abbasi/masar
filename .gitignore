# ==============================================================================
# Masar (مسار) - .gitignore
# High-precision Git exclusion rules for Python 3.11+, FastEmbed, SQLite,
# Node.js/Vite frontend, testing suites, and AI agent workspaces.
# ==============================================================================

# ------------------------------------------------------------------------------
# Python: Bytecode, optimization, and C extensions
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ------------------------------------------------------------------------------
# Distribution & Packaging
# ------------------------------------------------------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
venv.bak/
.uv/

# ------------------------------------------------------------------------------
# Testing, Coverage, Type Checking & Linting
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.hypothesis/
coverage.xml
*.cover
nosetests.xml

# ------------------------------------------------------------------------------
# Test Runtime Output Artifacts
# Keep .gitkeep so the directory exists in fresh checkouts, but ignore generated JSON/logs
# ------------------------------------------------------------------------------
test-artifacts/*
!test-artifacts/.gitkeep

# ------------------------------------------------------------------------------
# SQLite & Database Runtime Files
# Ignore runtime and temporary WAL/SHM/journal files; preserve test fixtures
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
!tests/fixtures/*.db
!tests/fixtures/*.sqlite
!tests/fixtures/*.sqlite3

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Certificates
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# Node.js & Web Verification Workbench (src/web)
# ------------------------------------------------------------------------------
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/
src/web/dist/
src/web/dist-ssr/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
*~
.directory
.fuse_hidden*

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# AI Agent Workspaces, Tooling & Ephemeral Backups
# ------------------------------------------------------------------------------
.gemini/
.claude/
.cursor/
.aider*
scratch/
*.bak
*.bak.*
*.tmp
